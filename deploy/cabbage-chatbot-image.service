[Unit]
Description=Follow the main chatbot image and update Cabbage
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
WorkingDirectory=/opt/archivebox.demo
Environment=DEPLOY_INTERVAL=60
ExecStart=/opt/archivebox.demo/bin/watch_chatbot_image.sh
Restart=always
RestartSec=60

[Install]
WantedBy=multi-user.target
